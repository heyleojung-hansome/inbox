# Gemini API 키 (https://aistudio.google.com/apikey 에서 발급). 비워두면 내장 예비 모드로 동작합니다.
GEMINI_API_KEY=
# 사용할 Gemini 모델 (기본값: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# 데이터베이스. 로컬은 SQLite 파일, 배포 시에는 Turso 주소와 토큰을 넣습니다.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# 앱 접속 비밀번호. 인터넷에 배포할 때는 꼭 설정하세요. 비워두면 비밀번호 없이 열립니다.
APP_PASSCODE=

# 학습 날짜 기준 시간대
APP_TIMEZONE=Asia/Seoul
